{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the local shell UI (the tab bar) and all app commands used by it.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-get-state",
    "allow-open-tab",
    "allow-switch-tab",
    "allow-close-tab",
    "allow-navigate",
    "allow-go-back",
    "allow-reload",
    "allow-hibernate",
    "allow-wake",
    "allow-cycle-tab",
    "allow-import-twitch-token",
    "allow-toggle-compact",
    "allow-toggle-always-on-top",
    "allow-set-webview-visible",
    "allow-open-extensions-folder",
    "allow-list-extensions",
    "allow-get-runtime-stats",
    "allow-toggle-ui-studio",
    "allow-list-installed-extensions",
    "allow-open-extension-popup",
    "allow-close-extension-popup",
    "allow-set-overlay-active",
    "allow-native-connect",
    "allow-native-post-message",
    "allow-native-disconnect"
  ]
}
